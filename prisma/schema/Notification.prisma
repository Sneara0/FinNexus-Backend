model Notification {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  message    String
  type       NotificationType
  link       String?
  isRead     Boolean        @default(false)
  readAt     DateTime?
  metadata   Json?
  createdAt  DateTime       @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}